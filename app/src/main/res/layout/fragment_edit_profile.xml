<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Editar Perfil"
            android:textAlignment="center"
            android:textColor="#4A148C"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Datos Personales"
                android:textAllCaps="true"
                android:textSize="14sp"
                android:textColor="#4A148C"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/etEditName"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:hint="Nombre"
                android:background="@drawable/bg_input_field"
                android:paddingStart="12dp"
                android:layout_marginBottom="12dp"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/etEditLastName"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:hint="Apellidos"
                android:background="@drawable/bg_input_field"
                android:paddingStart="12dp"
                android:layout_marginBottom="12dp"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/etEditBirth"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:hint="F. Nacimiento"
                android:background="@drawable/bg_input_field"
                android:paddingStart="12dp"
                android:layout_marginBottom="12dp"
                android:textSize="14sp"
                android:focusable="false"
                android:clickable="true"/>

            <EditText
                android:id="@+id/etEditGender"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:hint="Género"
                android:background="@drawable/bg_input_field"
                android:paddingStart="12dp"
                android:layout_marginBottom="16dp"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Datos de Acceso"
                android:textAllCaps="true"
                android:textSize="14sp"
                android:textColor="#4A148C"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="8dp"/>

            <EditText
                android:id="@+id/etEditEmail"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:hint="Correo electrónico"
                android:inputType="textEmailAddress"
                android:background="@drawable/bg_input_field"
                android:paddingStart="12dp"
                android:layout_marginBottom="12dp"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/etEditPass"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:hint="Nueva contraseña (dejar vacío para no cambiar)"
                android:inputType="textPassword"
                android:background="@drawable/bg_input_field"
                android:paddingStart="12dp"
                android:layout_marginBottom="16dp"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Intereses:"
                android:textSize="14sp"
                android:textColor="#4A148C"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_input_field"
                android:backgroundTint="#F3E5F5"
                android:padding="10dp"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <CheckBox android:id="@+id/cbEditEstres" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estrés" android:textSize="14sp" />
                    <CheckBox android:id="@+id/cbEditAnsiedad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ansiedad" android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <CheckBox android:id="@+id/cbEditSueno" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sueño" android:textSize="14sp" />
                    <CheckBox android:id="@+id/cbEditAnimo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ánimo" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="GUARDAR CAMBIOS"
                android:textStyle="bold"
                android:backgroundTint="#D1C4FF"
                app:cornerRadius="12dp"
                android:textColor="#4A148C" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>