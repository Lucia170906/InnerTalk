<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fondo_app"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_auth"
            android:elevation="4dp"
            android:padding="32dp"
            android:text="@string/auth_login_header"
            android:textAlignment="center"
            android:textColor="@color/lavanda_texto"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="32dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_login_title"
                android:textAllCaps="true"
                android:textSize="14sp"
                android:letterSpacing="0.1"
                android:textColor="@color/lavanda_texto"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/etLoginUser"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field"
                android:hint="@string/auth_hint_email"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                android:importantForAutofill="no" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:hintEnabled="false"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/lavanda_texto"
                app:boxBackgroundMode="none"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLoginPass"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/auth_hint_password"
                    android:inputType="textPassword"
                    android:paddingStart="12dp"
                    android:paddingEnd="48dp"
                    android:textSize="14sp"
                    android:importantForAutofill="no" />

            </com.google.android.material.textfield.TextInputLayout>


            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/auth_btn_login"
                android:backgroundTint="@color/morado_principal"
                app:cornerRadius="12dp"
                android:textColor="@color/lavanda_texto"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:layout_marginBottom="24dp"
                android:text="@string/auth_forgot_password"
                android:textColor="@color/lavanda_texto"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="4dp" />

            <TextView
                android:id="@+id/tvGoToRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_go_to_register"
                android:textAlignment="center"
                android:textColor="@color/lavanda_texto"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>