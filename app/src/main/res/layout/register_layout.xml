<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_auth"
            android:elevation="4dp"
            android:padding="32dp"
            android:text="@string/auth_register_title"
            android:textAlignment="center"
            android:textColor="#4A148C"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_new_account"
                android:textAllCaps="true"
                android:textSize="14sp"
                android:letterSpacing="0.1"
                android:textColor="#4A148C"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:orientation="vertical">

                    <EditText android:id="@+id/etRegisterName" android:layout_width="match_parent" android:layout_height="42dp"
                        android:hint="@string/auth_hint_name" android:background="@drawable/bg_input_field"
                        android:paddingStart="12dp" android:layout_marginBottom="8dp" android:textSize="14sp"
                        android:importantForAutofill="no" android:inputType="textPersonName"/>

                    <EditText android:id="@+id/etRegisterLastName" android:layout_width="match_parent" android:layout_height="42dp"
                        android:hint="@string/auth_hint_lastname" android:background="@drawable/bg_input_field"
                        android:paddingStart="12dp" android:layout_marginBottom="8dp" android:textSize="14sp"
                        android:importantForAutofill="no" android:inputType="textPersonName"/>

                    <EditText  android:id="@+id/etRegisterBirth" android:layout_width="match_parent" android:layout_height="42dp"
                        android:hint="@string/auth_hint_birth" android:background="@drawable/bg_input_field"
                        android:paddingStart="12dp" android:layout_marginBottom="8dp" android:textSize="14sp"
                        android:focusable="false" android:clickable="true" android:importantForAutofill="no" />

                    <EditText android:id="@+id/etRegisterGender"  android:layout_width="match_parent" android:layout_height="42dp"
                        android:hint="@string/auth_hint_gender" android:background="@drawable/bg_input_field"
                        android:paddingStart="12dp" android:textSize="14sp" android:importantForAutofill="no" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.9"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_input_field"
                    android:backgroundTint="#F3E5F5"
                    android:padding="10dp"
                    android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/auth_interests_label" android:textSize="11sp" android:textColor="#4A148C" android:textStyle="bold"/>
                    <CheckBox android:id="@+id/cbEstres" android:layout_width="wrap_content" android:layout_height="32dp" android:text="@string/auth_interest_stress" android:textSize="12sp" />
                    <CheckBox android:id="@+id/cbAnsiedad" android:layout_width="wrap_content" android:layout_height="32dp" android:text="@string/auth_interest_anxiety" android:textSize="12sp" />
                    <CheckBox android:id="@+id/cbSueno" android:layout_width="wrap_content" android:layout_height="32dp" android:text="@string/auth_interest_sleep" android:textSize="12sp" />
                    <CheckBox android:id="@+id/cbAnimo" android:layout_width="wrap_content" android:layout_height="32dp" android:text="@string/auth_interest_mood" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <EditText
                android:id="@+id/etRegisterEmail"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:hint="@string/auth_hint_email"
                android:inputType="textEmailAddress"
                android:background="@drawable/bg_input_field"
                android:paddingStart="12dp"
                android:layout_marginTop="12dp"
                android:textSize="14sp"
                android:importantForAutofill="no" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="#4A148C"
                app:boxBackgroundMode="none"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegisterPass"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="@string/auth_hint_password"
                    android:inputType="textPassword"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="12dp"
                    android:paddingEnd="48dp"
                    android:textSize="14sp"
                    android:importantForAutofill="no" />

            </com.google.android.material.textfield.TextInputLayout>
            <CheckBox
                android:id="@+id/cbPoliticas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/lavanda_texto"
                android:text="@string/auth_accept_policies"/>

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="@string/auth_btn_register"
                android:textStyle="bold"
                android:backgroundTint="#D1C4FF"
                app:cornerRadius="12dp"
                android:textColor="#4A148C" />

            <TextView
                android:id="@+id/tvGoToLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_go_to_login"
                android:textAlignment="center"
                android:textColor="#4A148C"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>