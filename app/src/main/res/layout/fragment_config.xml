<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPerfil"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/config_btn_profile"
        android:textColor="@color/lavanda_texto"
        android:textAllCaps="false"
        android:gravity="start|center_vertical"
        android:paddingStart="20dp"
        app:backgroundTint="@color/lavanda_claro"
        app:cornerRadius="32dp"
        app:icon="@drawable/icon_config"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:iconPadding="16dp"
        app:iconTint="@color/lavanda_texto" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/config_label_settings"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:textColor="@color/lavanda_texto" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:cardBackgroundColor="@color/lavanda_claro"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/notification_icon"
                android:contentDescription="@string/desc_config_notif_icon"
                app:tint="@color/lavanda_texto" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="@string/config_notif_reminder"
                android:textColor="@color/lavanda_texto" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchNotificaciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIdioma"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="10dp"
        android:text="@string/config_btn_language"
        android:textColor="@color/lavanda_texto"
        android:textAllCaps="false"
        android:gravity="start|center_vertical"
        android:paddingStart="20dp"
        app:backgroundTint="@color/lavanda_claro"
        app:cornerRadius="32dp"
        app:icon="@drawable/lenguage_icon"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:iconPadding="16dp"
        app:iconTint="@color/lavanda_texto" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/config_label_support"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:textColor="@color/lavanda_texto" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIncidencia"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/config_btn_incidence"
        android:textColor="@color/lavanda_texto"
        android:textAllCaps="false"
        android:gravity="start|center_vertical"
        android:paddingStart="20dp"
        app:backgroundTint="@color/lavanda_claro"
        app:cornerRadius="32dp"
        app:icon="@drawable/incidence_icon"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:iconPadding="16dp"
        app:iconTint="@color/lavanda_texto" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPoliticas"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="10dp"
        android:text="@string/config_btn_policies"
        android:textColor="@color/lavanda_texto"
        android:textAllCaps="false"
        android:gravity="start|center_vertical"
        android:paddingStart="20dp"
        app:backgroundTint="@color/lavanda_claro"
        app:cornerRadius="32dp"
        app:icon="@drawable/policy_icon"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:iconPadding="16dp"
        app:iconTint="@color/lavanda_texto" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrarSesion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"
        android:text="@string/config_btn_logout"
        android:textColor="@color/texto_salir"
        android:textAllCaps="false"
        android:paddingHorizontal="30dp"
        app:backgroundTint="@color/boton_salir"
        app:cornerRadius="24dp" />

</LinearLayout>