        <string name="act_title_1">Meditación Guiada</string>
        <string name="act_desc_1">Reduce el cortisol y calma la ansiedad mediante una guía profesional que aquieta tus pensamientos.</string>

        <string name="act_title_2">Caminar Consciente</string>
        <string name="act_desc_2">Mejora la conexión mente-cuerpo y reduce la rumiación mental al enfocarte en tus sensaciones físicas.</string>

        <string name="act_title_3">Respiración 4-7-8</string>
        <string name="act_desc_3">Activa el sistema nervioso parasimpático para un alivio inmediato del estrés y ayuda a conciliar el sueño.</string>

        <string name="act_title_4">Escaneo Corporal</string>
        <string name="act_desc_4">Identifica y libera tensiones acumuladas en los músculos, promoviendo una relajación profunda antes de dormir.</string>

        <string name="act_title_5">Técnica 5-4-3-2-1</string>
        <string name="act_desc_5">Detiene ataques de pánico o ansiedad intensa mediante el anclaje sensorial en el momento presente.</string>

        <string name="act_title_6">Comer con Atención</string>
        <string name="act_desc_6">Mejora la digestión y la relación con la comida al reducir la impulsividad y aumentar el placer sensorial.</string>

        <string name="act_title_7">Mirar las Estrellas</string>
        <string name="act_desc_7">Fomenta la sensación de \'asombro\' (awe), lo que reduce el ego y los problemas personales percibidos.</string>

        <string name="act_title_8">Baño de Sonido</string>
        <string name="act_desc_8">Utiliza frecuencias para sincronizar las ondas cerebrales, facilitando estados de meditación profunda sin esfuerzo.</string>

        <string name="act_title_9">Respiración de Caja</string>
        <string name="act_desc_9">Técnica usada por los Navy SEALs para mantener la calma y la claridad mental bajo presión extrema.</string>

        <string name="act_title_10">Escucha Activa</string>
        <string name="act_desc_10">Entrena la capacidad de concentración y reduce el ruido mental al enfocarte en el entorno externo.</string>

        <string name="act_title_11">Estiramiento Exprés</string>
        <string name="act_desc_11">Mejora la circulación y oxigenación cerebral, eliminando la rigidez causada por el sedentarismo.</string>

        <string name="act_title_12">Yoga Suave</string>
        <string name="act_desc_12">Aumenta la flexibilidad y libera bloqueos emocionales almacenados físicamente en las articulaciones.</string>

        <string name="act_title_13">Baile Libre</string>
        <string name="act_desc_13">Libera endorfinas y dopamina, mejorando el estado de ánimo de forma casi instantánea.</string>

        <string name="act_title_14">Abrazo de Mariposa</string>
        <string name="act_desc_14">Estimulación bilateral que ayuda al cerebro a procesar emociones difíciles y recuperar la calma.</string>

        <string name="act_title_15">Pies Descalzos</string>
        <string name="act_desc_15">Reduce la inflamación corporal y mejora el equilibrio gracias al contacto directo con la tierra.</string>

        <string name="act_title_16">Agua Fría</string>
        <string name="act_desc_16">Estimula el nervio vago, bajando las pulsaciones y reiniciando el sistema nervioso ante el estrés.</string>

        <string name="act_title_17">Relajación Progresiva</string>
        <string name="act_desc_17">Enseña al cerebro a reconocer la diferencia entre tensión y relajación, reduciendo el insomnio.</string>

        <string name="act_title_18">Caminar sin Rumbo</string>
        <string name="act_desc_18">Estimula la creatividad y el pensamiento lateral al quitar la presión de un objetivo o destino.</string>

        <string name="act_title_19">Automasaje</string>
        <string name="act_desc_19">Reduce los niveles de tensión en los tejidos blandos y mejora el flujo linfático en zonas críticas.</string>

        <string name="act_title_20">Postura de Poder</string>
        <string name="act_desc_20">Cambia la química hormonal aumentando la testosterona y bajando el cortisol para mayor confianza.</string>

        <string name="act_title_21">Diario de Gratitud</string>
        <string name="act_desc_21">Entrena al cerebro para detectar lo positivo, aumentando la felicidad a largo plazo según la ciencia.</string>

        <string name="act_title_22">Carta a mi Yo Futuro</string>
        <string name="act_desc_22">Ayuda a clarificar metas y valores, creando una visión de vida motivadora y coherente.</string>

        <string name="act_title_23">Registro de Logros</string>
        <string name="act_desc_23">Combate el síndrome del impostor y fortalece la autoeficacia al reconocer tus pequeñas victorias.</string>

        <string name="act_title_24">Desahogo Libre</string>
        <string name="act_desc_24">Drenaje emocional que permite exteriorizar traumas o frustraciones sin juicio externo.</string>

        <string name="act_title_25">Tiempo de Preocupación</string>
        <string name="act_desc_25">Evita que la ansiedad tome control de todo tu día al asignarle un horario y espacio limitado.</string>

        <string name="act_title_26">Reformular Pensamientos</string>
        <string name="act_desc_26">Técnica de Terapia Cognitivo Conductual para romper ciclos de autocrítica y pensamientos irracionales.</string>

        <string name="act_title_27">Lista de Perdón</string>
        <string name="act_desc_27">Libera la carga emocional del pasado y mejora la autoestima al aceptar nuestra humanidad.</string>

        <string name="act_title_28">Afirmaciones \'Yo Soy\'</string>
        <string name="act_desc_28">Reprograma creencias limitantes en el subconsciente mediante la repetición de verdades positivas.</string>

        <string name="act_title_29">El Frasco de lo Bueno</string>
